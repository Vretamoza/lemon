<Window x:Class="Lemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lemon" Width="400" Height="230"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#1E1E1E">

    <StackPanel VerticalAlignment="Center" Margin="28">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                       Foreground="#FFD43B" VerticalAlignment="Center"/>
            <TextBlock Text="Lemon" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Foreground="#AAAAAA" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0">
            Arrastra un archivo en cualquier parte y, sin soltarlo, toca
            <Run Foreground="#FFD43B" FontWeight="SemiBold">Shift</Run> para convertir o
            <Run Foreground="#FFD43B" FontWeight="SemiBold">Ctrl</Run> para herramientas.
        </TextBlock>

        <Border Background="#2A2A2A" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Listo" Foreground="White" FontSize="13"/>
                <TextBlock x:Name="DetailText" Text="Los archivos se guardan junto al original"
                           Foreground="#888888" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
