<Window x:Class="Lemon.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar imagen" Width="940" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#1B1B1B" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="6,0,18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botón propio: el estilo por defecto de Windows pinta de azul claro al pasar el mouse. -->
        <Style x:Key="LemonButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="#777777" FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Text="Arrastra bordes o esquinas · Flechas: mover (Shift ×10) · Enter: recortar · Esc: cancelar"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Foreground="#9A9A9A" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Lienzo: la imagen, el oscurecido de lo que se descarta y el marco de recorte.
             Todo es transparente al mouse; los eventos los maneja el propio lienzo. -->
        <Border Grid.Row="1" Margin="0,14" Background="#101010" CornerRadius="10" ClipToBounds="True">
            <Canvas x:Name="Stage" Background="Transparent" ClipToBounds="True"
                    SizeChanged="Stage_SizeChanged"
                    MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                    MouseMove="Stage_MouseMove"
                    MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                    LostMouseCapture="Stage_LostMouseCapture">
                <Image x:Name="Photo" Stretch="Fill" IsHitTestVisible="False"/>

                <Rectangle x:Name="ShadeTop" Fill="#A6000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="ShadeBottom" Fill="#A6000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="ShadeLeft" Fill="#A6000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="ShadeRight" Fill="#A6000000" IsHitTestVisible="False"/>

                <Line x:Name="GuideV1" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                <Line x:Name="GuideV2" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                <Line x:Name="GuideH1" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                <Line x:Name="GuideH2" Stroke="#55FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

                <Rectangle x:Name="CropFrame" Stroke="#FFD43B" StrokeThickness="1.5" Fill="{x:Null}"
                           IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <!-- Controles -->
        <StackPanel Grid.Row="2">
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="Proporción" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                <WrapPanel x:Name="RatioPanel"/>
            </DockPanel>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource LemonButton}" Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="Recortar" Style="{StaticResource LemonButton}"
                            Background="#FFD43B" Foreground="#1A1A1A" FontWeight="SemiBold"
                            Click="Accept_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="X" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="XBox" Width="64" LostFocus="Field_Commit" KeyDown="Field_KeyDown"/>
                    <TextBlock Text="Y" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="YBox" Width="64" LostFocus="Field_Commit" KeyDown="Field_KeyDown"/>
                    <TextBlock Text="Ancho" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WBox" Width="64" LostFocus="Field_Commit" KeyDown="Field_KeyDown"/>
                    <TextBlock Text="Alto" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="HBox" Width="64" LostFocus="Field_Commit" KeyDown="Field_KeyDown"/>
                    <TextBlock Text="px" Style="{StaticResource FieldLabel}" Foreground="#666666"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
